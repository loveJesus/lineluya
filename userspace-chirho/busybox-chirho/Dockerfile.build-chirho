# For God so loved the world that he gave his only begotten Son,
# that whoever believes in him should not perish but have eternal life. - John 3:16

# Build a static BusyBox binary for x86_64 using cross-compilation.
# Runs natively on ARM64 Mac Docker, cross-compiles to x86_64.

FROM alpine:latest AS builder

# Install cross-compilation toolchain
RUN apk add --no-cache \
    make perl bash wget bzip2 \
    gcc musl-dev linux-headers \
    gcc-x86_64-none-elf || true

# Alternative: just use the native Alpine tools on amd64
# If running on ARM, we'll use a pre-built busybox instead

# Download a pre-built static x86_64 BusyBox (most reliable approach)
RUN wget -q "https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox" \
    -O /busybox-static \
    && chmod +x /busybox-static

# Create initramfs
RUN mkdir -p /initramfs/bin /initramfs/sbin /initramfs/dev /initramfs/proc /initramfs/sys /initramfs/tmp /initramfs/etc /initramfs/root \
    && cp /busybox-static /initramfs/bin/busybox \
    && for cmd in sh ls cat echo mkdir mount ps uname pwd id env head tail wc grep sed vi \
       cp mv rm ln chmod chown touch date df du free top kill sleep clear hostname \
       dmesg ifconfig ping wget nc tr sort uniq tee xargs find test expr; do \
         ln -s busybox /initramfs/bin/$cmd 2>/dev/null || true; \
       done \
    && echo 'root:x:0:0:root:/root:/bin/sh' > /initramfs/etc/passwd \
    && echo 'root:x:0:' > /initramfs/etc/group \
    && echo 'Lineluya' > /initramfs/etc/hostname \
    && printf '#!/bin/sh\necho ""\necho "  Lineluya Linux - John 3:16"\necho "  For God so loved the world that he gave his only begotten Son,"\necho "  that whoever believes in him should not perish but have eternal life."\necho ""\nmount -t proc none /proc 2>/dev/null\nmount -t sysfs none /sys 2>/dev/null\nexport HOME=/root\nexport PATH=/bin:/sbin\nexec /bin/sh\n' > /initramfs/init \
    && chmod +x /initramfs/init

# Verify
RUN ls -la /initramfs/bin/busybox && ls /initramfs/bin/ | head -20

# Output stage — just the busybox binary and initramfs
FROM scratch
COPY --from=builder /initramfs/ /initramfs/
COPY --from=builder /busybox-static /busybox
