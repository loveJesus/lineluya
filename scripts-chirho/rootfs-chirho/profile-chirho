# For God so loved the world, that he gave his only begotten Son, that whosoever
# believeth in him should not perish, but have everlasting life. — John 3:16 (KJV)

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PS1='lineluya# '
export HOME=/root
export SHELL=/bin/sh
export TERM=linux
export DISPLAY=:0
export LD_LIBRARY_PATH=/tmp/lib-chirho:/lib:/usr/lib

mkdir -p /var/run /var/log /tmp/.X11-unix

DROPBEAR_GUARD_CHIRHO=/tmp/.dropbear-started-chirho
if mkdir "$DROPBEAR_GUARD_CHIRHO" 2>/dev/null; then
    if /usr/sbin/dropbear -R -E -B -p 2222; then
        echo "[SSH] Dropbear started on guest port 2222"
    else
        echo "[SSH] FATAL: Dropbear failed to start" >&2
        rmdir "$DROPBEAR_GUARD_CHIRHO" 2>/dev/null || true
    fi
fi

# Every /bin/sh -l reads this file, and xterm starts a login shell which then
# execs ANOTHER login shell — so an unconditional launch here fired the launcher
# once per login shell, not once per boot. A 400s run showed FIVE launcher execs
# — unconditional shebang records at log lines 336, 439, 4163, 4208 and 4258 —
# one at boot, then more as xterm's login-shell chain and its respawn each
# re-read /etc/profile.
#
# It was first reported as FOUR, and that undercount is worth keeping here. The
# '[EXEC] pid=N path' trace it was counted from fires only for pid >= 10, and the
# initial boot launcher is PID 7 — so the very launch this guard exists to make
# unique was the one the instrument could not see. Counting the unconditional
# shebang record instead gives five. No gate may key on a record emitted under a
# PID condition.
#
# The launcher's own `mkdir` guard is atomic and stayed authoritative, so this
# never produced a duplicate Xorg — but it did churn processes and violates the
# single-launch gate. Skipping when the guard already exists stops a login shell
# from invoking a launcher that is only going to exit 0.
#
# Deliberately NOT a replacement for the launcher's guard: it still does the
# atomic mkdir, and still rmdir's on its failure path, so a genuine launcher
# failure is retried by the next login shell. Two shells racing this test can
# still both exec the launcher; the launcher's mkdir remains what makes at most
# one of them proceed.
DESKTOP_GUARD_CHIRHO=/tmp/.lineluya-desktop-started-chirho
if [ -d "$DESKTOP_GUARD_CHIRHO" ]; then
    :
elif [ -x /usr/local/sbin/start-lineluya-desktop-chirho.sh ]; then
    /usr/local/sbin/start-lineluya-desktop-chirho.sh &
else
    echo "[DESKTOP] FATAL: rootfs launcher is missing" >&2
fi
